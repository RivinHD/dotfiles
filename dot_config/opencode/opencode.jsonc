{
    "$schema": "https://opencode.ai/config.json",
    "providers": {
        "gpustack": {
            "name": "Uni Jena GPUStack",
            "env": ["GPUSTACK_API_KEY"],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "https://gpustack.test.hs-itz.de/v1"
            },
            "models": {
                "glm-5.2-fp8": {
                    "name": "GLM-5.2 (GPUStack)",
                    "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
                    "limit": { "context": 524288, "output": 32768 }
                },
                // Limits probed against the live deployment on 2026-11-04.
                "stable-llm-max": {
                    "name": "Stable LLM Max (GPUStack)",
                    "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
                    "limit": { "context": 524288, "output": 16384 }
                },
                "stable-agentic": {
                    "name": "Stable Agentic (GPUStack)",
                    "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
                    "limit": { "context": 64000, "output": 16384 }
                },
                "qwen3.6-27b": {
                    "name": "Qwen3.6 27B (GPUStack)",
                    "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
                    "limit": { "context": 262144, "output": 16384 }
                }
            }
        }
    },
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "grep",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/opencode/*",
            "effect": "allow"
        }
    ],
    "websearch": {
        "provider": "tavily"
    },
    "update": "auto"
}
